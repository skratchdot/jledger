{
  "name": "jledger-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @jledger/web dev",
    "build": "pnpm --filter @jledger/core build && pnpm --filter @jledger/web build && pnpm --filter @jledger/cli build",
    "typecheck": "pnpm --filter @jledger/core build && pnpm -r typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "jledger": "tsx packages/cli/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "prettier": "^3.6.0",
    "@playwright/test": "1.64.1"
  }
}
