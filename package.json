{
  "name": "jledger-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @jledger/web dev",
    "build": "pnpm --filter @jledger/core build && pnpm --filter @jledger/web build && pnpm --filter @jledger/cli build",
    "typecheck": "pnpm --filter @jledger/core build && pnpm -r typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "jledger": "tsx packages/cli/src/index.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "test:compatibility": "pnpm --filter @jledger/core build && node scripts/compatibility.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
